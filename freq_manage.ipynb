   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "40e1d98c",
   "metadata": {},
   "outputs": [],
   "source": [
    "good_quad = pd.read_csv(\"goodQuadgram.csv\")\n",
    "good_tri = pd.read_csv(\"goodTriGrams.csv\")\n",
    "good_bi = pd.read_csv(\"goodBigram.csv\")\n",
    "good_uni = pd.read_csv(\"unigram_sorted.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "f43bbdf7",
   "metadata": {},
   "outputs": [],
   "source": [
    "good_bi = good_bi.loc[good_bi[\"documents\"]>2]\n",
    "good_uni = good_uni.loc[good_uni[\"documents\"]>2]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "c65f71ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "def extractGrams(gramNo,targetGramNo,data):\n",
    "    ans = []\n",
    "    i = 0\n",
    "    while(i<=(gramNo-targetGramNo)):\n",
    "        st = \"\"\n",
    "        for j in range(targetGramNo):\n",
    "            st += data[j+i] + \" \"\n",
    "        ans.append(st[:-1])\n",
    "        i += 1\n",
    "    return ans"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "0e7ae036",
   "metadata": {},
   "outputs": [],
   "source": [
    "def remove_duplicate(data):\n",
    "    seen = set()\n",
    "    result = []\n",
    "    for item in data:\n",
    "        if item[0] not in seen:\n",
    "            seen.add(item[0])\n",
    "            result.append(item)\n",
    "    return result"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f8a7463c",
   "metadata": {},
   "source": [
    "## Extracting grams from Qaudgrams"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "efb94c1e",
   "metadata": {},
   "outputs": [],
   "source": [
    "tri_terms = []\n",
    "bi_terms = []\n",
    "uni_terms = []\n",
    "\n",
    "for i,term in enumerate(good_quad[\"4-gram\"]):\n",
    "    term_li = term.split(\" \")\n",
    "\n",
    "    tri_li = extractGrams(4,3,term_li)\n",
    "    for tri in tri_li:\n",
    "        tri_terms.append((tri,i))\n",
    "\n",
    "    bi_li = extractGrams(4,2,term_li)\n",
    "    for bi in bi_li:\n",
    "        bi_terms.append((bi,i))\n",
    "\n",
    "    uni_li = extractGrams(4,1,term_li)\n",
    "    for uni in uni_li:\n",
    "        uni_terms.append((uni,i))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "ce79b55e",
   "metadata": {},
   "outputs": [],
   "source": [
    "tri_terms = remove_duplicate(tri_terms)\n",
    "bi_terms = remove_duplicate(bi_terms)\n",
    "uni_terms = remove_duplicate(uni_terms)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "60de6387",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i,tri in enumerate(good_tri[\"3-gram\"]):\n",
    "    for term in tri_terms:\n",
    "        if tri==term[0]:\n",
    "            value = good_tri[\"total freq\"][i] - good_quad[\"total freq\"][term[1]]\n",
    "            good_tri.loc[i,'total freq'] = value"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "1a489129",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i, bi in enumerate(good_bi[\"2-gram\"]):\n",
    "    for term in bi_terms:\n",
    "        if bi == term[0]:\n",
    "            value = good_bi[\"total freq\"].iloc[i] - good_quad[\"total freq\"].iloc[term[1]]\n",
    "            good_bi.loc[i, \"total freq\"] = value"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "5f066597",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i, uni in enumerate(good_uni[\"1-gram\"]):\n",
    "    for term in uni_terms:\n",
    "        if uni == term[0]:\n",
    "            value = good_uni[\"total freq\"].iloc[i] - good_quad[\"total freq\"].iloc[term[1]]\n",
    "            good_uni.loc[i, \"total freq\"] = value"
   ]
  },
